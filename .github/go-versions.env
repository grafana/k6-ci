# Single source of truth for the Go versions used across the CI workflows.
#
# Both values are bumped manually with each Go release:
#   GO_VERSION_CURRENT - the current Go minor version.
#   GO_VERSION_PREV    - the deliberate N-1 version (one minor behind CURRENT)
#                        kept for backwards-compatibility coverage.
#
# GO_VERSION_CURRENT is pinned to a patch release on purpose, because the
# golangci-lint version on line 1 of .golangci.yml cannot read the export data
# of Go 1.27.2 ("export data version 5 is greater than maximum supported
# version 4"). Go back to 1.27.x once that golangci-lint version can.
GO_VERSION_CURRENT=1.27.1
GO_VERSION_PREV=1.26.x
